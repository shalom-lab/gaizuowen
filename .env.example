# 本地开发用（可选）。
#
# 正式站点（GitHub Pages）没有后端，密钥由使用者在页面「设置」里填写，
# 保存在浏览器 localStorage：deepseek-zuowen-key
#
# 下面的 DEEPSEEK_API_KEY 只在 `npm run dev` 时被内联进开发版页面，
# `npm run build` 产物里始终为空，不会把密钥发布到公网。

DEEPSEEK_API_KEY="sk-your-key-here"

# 可选：自定义 API 地址 / 模型
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-flash"
